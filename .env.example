DATABASE_PATH=./data/training.db
PORT=3000
NODE_ENV=development

# Supabase public project values. Never use a secret or service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
VITE_AUTH_PROVIDERS=google
VITE_AUTH_SCOPES_JSON={}

# API-only JWT verification values.
AUTH_ISSUER=https://your-project.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Docker Compose topology.
API_DEV_PORT=3000
WEB_DEV_PORT=5173
APP_DOMAIN=work-ouch.example.com
TRAEFIK_NETWORK=proxy
